{
  "name": "codeguard-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CodeGuard — Enterprise AI Code Review, Security & Repository Intelligence Platform",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "demo:review": "tsx apps/review-worker/src/demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "db:generate": "pnpm --filter @codeguard/database db:generate",
    "db:migrate": "pnpm --filter @codeguard/database db:migrate",
    "db:push": "pnpm --filter @codeguard/database db:push",
    "db:seed": "pnpm --filter @codeguard/database db:seed"
  },
  "devDependencies": {
    "@octokit/auth-app": "^7.2.2",
    "@octokit/rest": "^21.1.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.4",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.3",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@google/genai": "^2.17.1"
  }
}
