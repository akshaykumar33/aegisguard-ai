# ==============================================================================
# AegisGuard AI — Master Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. NEXT.JS WEB APPLICATION & DOCUMENTATION PORTAL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="AegisGuard AI"
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_DOCS_URL=http://localhost:3001/docs
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ------------------------------------------------------------------------------
# 3. DATABASE (PostgreSQL / AWS Aurora PostgreSQL Serverless v2)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aegisguard_dev
DATABASE_MAX_CONNECTIONS=20
DATABASE_SSL=false
DATABASE_SCHEMA=public

# ------------------------------------------------------------------------------
# 4. CACHE & QUEUES (Redis 7.0 / AWS ElastiCache / BullMQ)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
QUEUE_CONCURRENCY=5

# ------------------------------------------------------------------------------
# 5. GITHUB & GITLAB APP INTEGRATIONS
# ------------------------------------------------------------------------------
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA0mockkey...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=development_webhook_secret_key_12345
GITHUB_CLIENT_ID=gh_client_id_mock
GITHUB_CLIENT_SECRET=gh_client_secret_mock

GITLAB_APP_ID=
GITLAB_APP_SECRET=
GITLAB_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 6. SECURITY & AUTHENTICATION (Zero-Trust & JWT)
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_at_least_32_chars_long_1234567890
JWT_EXPIRES_IN=7d
API_KEY_SALT=development_salt_key_for_api_tokens
ENTROPY_CRITICAL_THRESHOLD=4.200

# ------------------------------------------------------------------------------
# 7. AI & LLM PROVIDERS (Google Gemini 3.7 Flash & AWS Bedrock)
# ------------------------------------------------------------------------------
# Google Gemini 3.7 API
GEMINI_API_KEY=your_google_gemini_api_key_here
AI_DEFAULT_MODEL=gemini-2.5-flash
AI_DEEP_REASONING_MODEL=gemini-2.5-pro

# AWS Bedrock (Enterprise Failover)
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 8. S3 STORAGE (AST Snapshots, Diff Logs, Audit Bundles)
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=aegisguard-artifacts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# 9. NOTIFICATIONS & ALERTS
# ------------------------------------------------------------------------------
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
ALERT_EMAIL_FROM=alerts@aegisguard.ai
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
